# Variables del backend. La clave NUNCA va en el repositorio, el front ni los logs.
# En local se recomienda cargarla desde un almacén de secretos (ver README).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
PORT=8787
# Topes de costo (PRD §8)
MAX_ITERACIONES=25
MAX_TOKENS_SESION=300000
LLM_TIMEOUT_MS=60000
RATE_LIMIT=30
